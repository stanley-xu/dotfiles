# No [user] here on purpose: identity is per-person / per-machine, so it lives in
# the untracked ~/.gitconfig (see create_dot_gitconfig), never in this shared baseline.
[alias]
	# Status and diff
	stat = status --short # likely have the shell alias `gst`
	sh = show
	d = diff
	l = log
	lo = log --pretty=oneline --abbrev-commit
	lg = log --graph --decorate --pretty=oneline --abbrev-commit

	# Staging changes
	a = add
	aa = add .
	ac = "!git add . && git commit"
	acm = "!git add . && git commit --message"
	cm = "commit --message"

	# Change HEAD
	s = switch
	r = restore

	# Change branch
	rb = rebase
	rs = reset
	co = checkout

	# Pull
	f = fetch
	fo = fetch origin
	ff = pull --ff-only

	# Push
	pushup = "!git push --set-upstream origin $(git branch --show-current)"
	pf = push --force-with-lease

	# Workflows
	unstage = reset HEAD --
	discard = checkout --
	amend = commit --amend HEAD
	amend-reuse = commit --amend --reuse-message HEAD
	cp = cherry-pick --ff
	wt = worktree
	
# This file is the managed git baseline (chezmoi). It is included at the TOP of
# ~/.gitconfig, which chezmoi creates once and never touches again — so per-machine
# and tooling writes (git config --global ...) appended below the include override
# what's set here. See README "Shared and local configs for every computer".
[init]
	defaultBranch = main
