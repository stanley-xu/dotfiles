# Shared aliases, sourced by both zsh (main.zsh) and fish (conf.d/00-root.fish).
# Keep this file to `alias name='command'` lines and comments only: that one
# form is valid syntax in both shells.

# Shell
{{- if eq .chezmoi.os "darwin" }}
alias ls='gls --color'
{{- else }}
alias ls='ls --color'
{{- end }}
alias l='ls'
alias ll='ls -l'
alias la='ls -a'
alias lla='ls -la'

# Git
# Most git aliases moved to gitconfig for portability
alias g='git'
alias gst='git status --short'
